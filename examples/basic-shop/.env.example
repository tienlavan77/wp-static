# Copy this file to .env and fill real secrets on the VPS.
# Never commit examples/basic-shop/.env.

WPSC_WP_URL=https://api.tinsinhphat.com
WPSC_AUTH_ENDPOINT=/wp-json/wpsc/v1/auth/login
WPSC_AUTH_BRIDGE_SECRET=change_me_to_a_long_random_secret
WPSC_RUNTIME_PORT=8787

WPSC_WOO_CONSUMER_KEY=ck_replace_me
WPSC_WOO_CONSUMER_SECRET=cs_replace_me

# Optional WordPress auth for private REST endpoints.
WPSC_WP_USERNAME=
WPSC_WP_APP_PASSWORD=

# Optional builder/editor runtime secrets.
WPSC_BUILDER_TOKEN=
WPSC_WEBHOOK_SECRET=
