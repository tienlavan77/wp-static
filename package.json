{
  "name": "wpsc",
  "version": "1.0.0",
  "private": true,
  "description": "WPSC static commerce framework for production static builds.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node src/cli/index.js build",
    "build:css:example": "tailwindcss -i examples/basic-shop/theme/storefront.css -o examples/basic-shop/public/storefront.css --minify",
    "prebuild:example": "npm run build:css:example",
    "build:example": "node src/cli/index.js build --project examples/basic-shop",
    "build:route": "node scripts/build-route.js",
    "serve:runtime:example": "node examples/basic-shop/runtime/server.js",
    "wpsc": "node src/cli/index.js",
    "test": "node --test"
  },
  "exports": {
    ".": "./src/index.js",
    "./adapters": "./packages/adapters/src/index.js",
    "./builder": "./packages/builder/src/index.js",
    "./cli": "./packages/cli/src/index.js",
    "./core": "./packages/core/src/index.js",
    "./renderer": "./packages/renderer/src/index.js",
    "./router": "./packages/router/src/index.js",
    "./shared": "./packages/shared/src/index.js"
  },
  "bin": {
    "wpsc": "./src/cli/index.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2"
  }
}
